# ─────────────────────────────────────────────────────────────────────
# Vehicle Intelligence Assistant — Backend Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────

# ── Google Gemini API ──────────────────────────────────────────────
# Required. Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for answer generation
GEMINI_MODEL=gemini-2.0-flash

# ── Database ───────────────────────────────────────────────────────
# Path to the SQLite database file (created automatically on first run)
DATABASE_PATH=./data/app.db

# ── File Storage ───────────────────────────────────────────────────
# Directory where uploaded documents are stored
UPLOAD_DIR=./data/documents

# ── Vector Store ───────────────────────────────────────────────────
# Directory where ChromaDB persists embeddings
VECTOR_DB_PATH=./data/vectordb

# Sentence-Transformers embedding model (downloaded on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Number of top-k chunks retrieved per query
TOP_K_RESULTS=5

# ── API Settings ───────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Application environment (development | production)
ENVIRONMENT=development
