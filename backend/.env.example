# ─────────────────────────────────────────────────────────────────────────────
# Auron — Backend Environment Variables Template
# Copy this to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── Google Gemini AI ──────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-2.0-flash-lite

# ── Supabase (Persistent Storage) ─────────────────────────────────────────────
# Find these at: https://app.supabase.com → your project → Settings → API Keys
#
# SUPABASE_URL:               Your project URL (e.g. https://xxxxx.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY:  Secret key (sb_secret_...) — backend only, NEVER frontend!
#
# !! Set these as secrets in your Render dashboard, never commit real values !!
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# ── Database (SQLite — used locally if SUPABASE_URL is not set) ───────────────
DATABASE_PATH=./data/vehicle_intelligence.db

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=.pdf,.csv,.xlsx,.docx,.txt

# ── Vector Store (ChromaDB) ───────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=vehicle_docs

# ── RAG Settings ──────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://auron-frontend.onrender.com
