# ─────────────────────────────────────────────────────────────────────────────
# Auron — Backend Environment Variables Template
# Copy this to .env and fill in your values.
#
# Variable names MUST match exactly what's in app/config.py
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development          # "development" or "production"
DEBUG=true                   # Set to false in production

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Valid Gemini model names (choose one):
#   gemini-2.0-flash-lite    (fastest, recommended for free tier)
#   gemini-2.0-flash         (balanced speed/quality)
#   gemini-1.5-flash         (older but reliable)
GEMINI_LLM_MODEL=gemini-2.0-flash-lite

# ── Supabase (Persistent Storage) ─────────────────────────────────────────────
# Find these at: https://app.supabase.com → your project → Settings → API
# !! NEVER commit real values — set these in your Render dashboard as secrets !!

# Your Supabase project URL (e.g. https://xxxxxxxxxxxxx.supabase.co)
SUPABASE_URL=

# Service role key — has full database access, backend-only, never expose to frontend
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL connection string for asyncpg
# Found at: Supabase → Settings → Database → Connection string → URI
# Use the "Session mode" pooler (port 5432) or direct connection
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Supabase Storage bucket name (create this in Supabase → Storage)
SUPABASE_STORAGE_BUCKET=documents

# ── Database (SQLite — used locally when SUPABASE_DB_URL is not set) ──────────
DATABASE_PATH=./data/vehicle_intelligence.db

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=.pdf,.csv,.xlsx,.docx,.txt

# ── Vector Store (ChromaDB) ───────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=vehicle_docs

# ── RAG Settings ──────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# ── CORS (comma-separated list of allowed frontend origins) ───────────────────
# Development: localhost ports
# Production: set to your Render frontend URL
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://auron-frontend.onrender.com
