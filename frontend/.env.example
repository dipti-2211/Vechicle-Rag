# ─────────────────────────────────────────────────────────────────────
# Vehicle Intelligence Assistant — Frontend Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────

# URL of the backend API (no trailing slash)
# For local development:
VITE_API_URL=http://localhost:8000

# For Docker / production (points to backend service):
# VITE_API_URL=http://backend:8000

# ── Supabase Auth (Public — safe to commit) ──────────────────────────
# Find these in: Supabase Dashboard → Settings → API Keys
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are the PUBLIC anon key.
# NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here
